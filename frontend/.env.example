# Description: Example environment configuration for the United Pass frontend
#
# Copy to `.env.local` for local overrides. Never commit real credentials.

# Data source switch (frontend-freeze-v1.md §5, ADR-0004):
#   "true"  -> every seam uses the mock data source (local demo, e2e)
#   absent  -> migrated seams call the real backend HTTP API; unmigrated
#              seams stay on the mock source
# NEXT_PUBLIC_ is required because browser-side commands read the flag too.
NEXT_PUBLIC_USE_MOCK=true

# Server-side base URL of the Go backend API used by server-http-client.ts.
# Browser requests always go to the same-origin /api/v1 via the reverse proxy.
API_BASE_URL=http://localhost:8080/api/v1

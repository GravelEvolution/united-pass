# Runtime
UP_ENVIRONMENT=development
UP_LOG_LEVEL=debug

# SSH tunnel (managed by scripts/tunnel.sh)
# Remote PostgreSQL and Redis are reached through an encrypted SSH tunnel so
# the API connects to localhost only. Plaintext never crosses the public
# network. See README "Secure Remote Access".
# Notes:
# - tunnel.sh reads ONLY the UP_SSH_* / UP_LOCAL_* / UP_REMOTE_* variables
#   from this file; it never sources it, and values may be double-quoted.
# - A leading "~/" in UP_SSH_KEY is expanded to $HOME by the script.
# - Prefer key authentication: SSH runs with BatchMode=yes and
#   IdentitiesOnly=yes, so UP_SSH_KEY must be an existing private key.
# - Optional password fallback: set UP_SSH_PASSWORD to authenticate with
#   sshpass instead of a key. In password mode BatchMode=yes and
#   IdentitiesOnly=yes are NOT enabled, and UP_SSH_KEY is not required.
#   Requires sshpass (brew install sshpass). Never commit the real password.
#   The password is handed to sshpass through the SSHPASS environment
#   variable (sshpass -e) only, so it never appears in process arguments,
#   logs, or PID files; tunnel.sh unsets it right after the tunnel starts.
UP_SSH_HOST="<remote-host>"
UP_SSH_PORT=22
UP_SSH_USER="<ssh-user>"
UP_SSH_KEY="~/.ssh/id_ed25519"
UP_SSH_PASSWORD=""
UP_LOCAL_PG_PORT=15432
UP_LOCAL_REDIS_PORT=16379

# PostgreSQL (through the SSH tunnel: 127.0.0.1:15432 -> remote 5432)
# Password must be URL encoded.
UP_DATABASE_URL="postgres://<username>:<url-encoded-password>@127.0.0.1:15432/<database>?sslmode=disable"
UP_DATABASE_SCHEMA=united_pass
UP_DATABASE_MAX_CONNS=10
UP_DATABASE_MIN_CONNS=1
UP_DATABASE_CONNECT_TIMEOUT=10s

# Redis (through the SSH tunnel: 127.0.0.1:16379 -> remote 6379)
# Password must be URL encoded.
UP_REDIS_URL="redis://:<url-encoded-password>@127.0.0.1:16379/0"
UP_REDIS_KEY_PREFIX=up:development:
UP_REDIS_POOL_SIZE=10
UP_REDIS_CONNECT_TIMEOUT=10s
UP_REDIS_READ_TIMEOUT=3s
UP_REDIS_WRITE_TIMEOUT=3s

# Browser Session
UP_SESSION_TTL=12h
UP_SESSION_REMEMBER_TTL=720h
UP_SESSION_IDLE_TTL=2h
UP_SESSION_TOUCH_INTERVAL=5m
UP_SESSION_COOKIE_SECURE=false
UP_SESSION_COOKIE_SAME_SITE=lax

# Session payload encryption
# Required when provider session credentials are stored.
# Generate a cryptographically random 32-byte key and encode it as base64.
UP_SESSION_ENCRYPTION_KEY="<base64-encoded-32-byte-key>"
UP_SESSION_ENCRYPTION_KEY_ID=development-v1

# Authentication Provider (Phase 1.2: ZITADEL)
#   UP_AUTH_PROVIDER=fake     -> development fake (non-production only)
#   UP_AUTH_PROVIDER=zitadel  -> ZITADEL LoginV2 adapter (all environments)
# For the local ZITADEL instance (docker-compose.zitadel.yml + 
# scripts/zitadel-init.sh), use:
#   UP_AUTH_PROVIDER=zitadel
#   UP_AUTH_PROVIDER_BASE_URL="http://localhost:8080"
#   UP_AUTH_PROVIDER_PROJECT_ID="<project-id>"
#   UP_AUTH_PROVIDER_SERVICE_ACCOUNT_KEY_FILE="<path>/sa-key.json"
#   UP_AUTH_PROVIDER_DOMAIN="localhost"
# The service account key file is created by scripts/zitadel-init.sh; never
# commit it (see .gitignore). Production requires an HTTPS base URL and the
# key delivered via secrets management.
UP_AUTH_PROVIDER="<provider-name>"
UP_AUTH_PROVIDER_BASE_URL="<https-url>"
UP_AUTH_PROVIDER_PROJECT_ID="<project-id>"
UP_AUTH_PROVIDER_CLIENT_ID="<client-id>"
UP_AUTH_PROVIDER_CLIENT_SECRET="<client-secret>"
UP_AUTH_PROVIDER_SERVICE_ACCOUNT_KEY_FILE="<path-to-service-account-key.json>"
UP_AUTH_PROVIDER_DOMAIN="<webauthn-relying-party-domain>"

# OAuth endpoint topology (Phase 3.6)
# The public origin the reverse proxy serves the OAuth protocol endpoints on
# (issuer origin the browser sees). This is an ORIGIN, not a base URL:
# scheme + host (+ port) only - no path, userinfo, query or fragment.
#   UP_OAUTH_PUBLIC_ORIGIN=https://id.example.com   production (https required)
#   UP_OAUTH_PUBLIC_ORIGIN=http://localhost:3000    development
# The ZITADEL LoginV2 Interaction Base URI is DERIVED as <origin>/_interaction;
# it is never configured independently. Do NOT reuse UP_AUTH_PROVIDER_BASE_URL
# here: that value is the internal provider management/API address, while this
# is the browser-visible public issuer origin.
UP_OAUTH_PUBLIC_ORIGIN="<https-origin>"

# MFA and Rate Limiting
UP_MFA_CHALLENGE_TTL=5m
UP_MFA_MAX_ATTEMPTS=5
UP_LOGIN_RATE_LIMIT=10
UP_LOGIN_RATE_WINDOW=15m
UP_MFA_RATE_LIMIT=10
UP_MFA_RATE_WINDOW=15m

# Integration tests (through the tunnel; separate schema and Redis DB)
UP_TEST_DATABASE_URL="postgres://<test-user>:<url-encoded-password>@127.0.0.1:15432/<test-database>?sslmode=disable"
UP_TEST_DATABASE_SCHEMA=united_pass_test
UP_TEST_REDIS_URL="redis://:<url-encoded-password>@127.0.0.1:16379/1"
UP_TEST_REDIS_KEY_PREFIX=up:test:

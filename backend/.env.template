# Runtime
UP_ENVIRONMENT=development
UP_LOG_LEVEL=debug

# SSH tunnel (managed by scripts/tunnel.sh)
# Remote PostgreSQL and Redis are reached through an encrypted SSH tunnel so
# the API connects to localhost only. Plaintext never crosses the public
# network. See README "Secure Remote Access".
# Note: scripts/tunnel.sh sources this file, so values containing shell
# metacharacters (< > & | etc.) must be double-quoted.
UP_SSH_HOST="<remote-host>"
UP_SSH_PORT=22
UP_SSH_USER="<ssh-user>"
UP_SSH_KEY="~/.ssh/<ssh-key>"
UP_LOCAL_PG_PORT=15432
UP_LOCAL_REDIS_PORT=16379

# PostgreSQL (through the SSH tunnel: 127.0.0.1:15432 -> remote 5432)
# Password must be URL encoded.
UP_DATABASE_URL="postgres://<username>:<url-encoded-password>@127.0.0.1:15432/<database>?sslmode=disable"
UP_DATABASE_SCHEMA=united_pass
UP_DATABASE_MAX_CONNS=10
UP_DATABASE_MIN_CONNS=1
UP_DATABASE_CONNECT_TIMEOUT=10s

# Redis (through the SSH tunnel: 127.0.0.1:16379 -> remote 6379)
# Password must be URL encoded.
UP_REDIS_URL="redis://:<url-encoded-password>@127.0.0.1:16379/0"
UP_REDIS_KEY_PREFIX=up:development:
UP_REDIS_POOL_SIZE=10
UP_REDIS_CONNECT_TIMEOUT=10s
UP_REDIS_READ_TIMEOUT=3s
UP_REDIS_WRITE_TIMEOUT=3s

# Browser Session
UP_SESSION_TTL=12h
UP_SESSION_REMEMBER_TTL=720h
UP_SESSION_IDLE_TTL=2h
UP_SESSION_TOUCH_INTERVAL=5m
UP_SESSION_COOKIE_SECURE=false
UP_SESSION_COOKIE_SAME_SITE=lax

# Session payload encryption
# Required when provider session credentials are stored.
# Generate a cryptographically random 32-byte key and encode it as base64.
UP_SESSION_ENCRYPTION_KEY="<base64-encoded-32-byte-key>"
UP_SESSION_ENCRYPTION_KEY_ID=development-v1

# Authentication Provider
UP_AUTH_PROVIDER="<provider-name>"
UP_AUTH_PROVIDER_BASE_URL="<https-url>"
UP_AUTH_PROVIDER_PROJECT_ID="<project-id>"
UP_AUTH_PROVIDER_CLIENT_ID="<client-id>"
UP_AUTH_PROVIDER_CLIENT_SECRET="<client-secret>"

# MFA and Rate Limiting
UP_MFA_CHALLENGE_TTL=5m
UP_MFA_MAX_ATTEMPTS=5
UP_LOGIN_RATE_LIMIT=10
UP_LOGIN_RATE_WINDOW=15m
UP_MFA_RATE_LIMIT=10
UP_MFA_RATE_WINDOW=15m

# Integration tests (through the tunnel; separate schema and Redis DB)
UP_TEST_DATABASE_URL="postgres://<test-user>:<url-encoded-password>@127.0.0.1:15432/<test-database>?sslmode=disable"
UP_TEST_DATABASE_SCHEMA=united_pass_test
UP_TEST_REDIS_URL="redis://:<url-encoded-password>@127.0.0.1:16379/1"
UP_TEST_REDIS_KEY_PREFIX=up:test:

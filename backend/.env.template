# United Pass backend environment template
#
# Copy to an ignored `.env` file for local development. Keep secrets empty in
# source control and inject real values through the deployment secret store.
# Feature gates are deliberately off; enabling one requires satisfying the
# corresponding validation rules in internal/config.

# Runtime and HTTP server
UP_ENVIRONMENT=development
UP_HTTP_ADDR=:8080
UP_READ_HEADER_TIMEOUT=5s
UP_READ_TIMEOUT=15s
UP_WRITE_TIMEOUT=30s
UP_IDLE_TIMEOUT=60s
UP_SHUTDOWN_TIMEOUT=30s
UP_MAX_REQUEST_BODY_BYTES=1048576
UP_LOG_LEVEL=info
UP_AVATAR_DIR="/var/lib/moonstone-united-pass/avatars"

# Development SSH tunnel (scripts/tunnel.sh only; not API runtime config)
# Prefer key authentication. Leave UP_SSH_PASSWORD empty in this template.
UP_SSH_HOST="<remote-host>"
UP_SSH_PORT=22
UP_SSH_USER="<ssh-user>"
UP_SSH_KEY="~/.ssh/id_ed25519"
UP_SSH_PASSWORD=""
UP_LOCAL_PG_PORT=15432
UP_LOCAL_REDIS_PORT=16379
UP_REMOTE_PG_PORT=5432
UP_REMOTE_REDIS_PORT=6379
UP_REMOTE_DB_BIND=127.0.0.1
UP_REMOTE_REDIS_BIND=127.0.0.1

# PostgreSQL authority store
# Local tunnel example:
# postgres://<username>:<url-encoded-password>@127.0.0.1:15432/<database>?sslmode=disable
UP_DATABASE_URL=""
UP_DATABASE_SCHEMA=united_pass
UP_DATABASE_MAX_CONNS=10
UP_DATABASE_MIN_CONNS=1
UP_DATABASE_CONNECT_TIMEOUT=10s

# Isolated DreamUP/Mini Program operational store
# Must select a database distinct from the authority database when enabled.
UP_ISOLATED_DATABASE_URL=""
UP_ISOLATED_DATABASE_SCHEMA=dreamup_isolated
UP_ISOLATED_DATABASE_MAX_CONNS=10
UP_ISOLATED_DATABASE_MIN_CONNS=1
UP_ISOLATED_DATABASE_CONNECT_TIMEOUT=10s

# Redis
# Local tunnel example:
# redis://:<url-encoded-password>@127.0.0.1:16379/0
UP_REDIS_URL=""
UP_REDIS_KEY_PREFIX=up:development:
UP_REDIS_POOL_SIZE=10
UP_REDIS_CONNECT_TIMEOUT=10s
UP_REDIS_READ_TIMEOUT=3s
UP_REDIS_WRITE_TIMEOUT=3s

# Browser sessions
UP_SESSION_TTL=12h
UP_SESSION_REMEMBER_TTL=720h
UP_SESSION_IDLE_TTL=2h
UP_SESSION_TOUCH_INTERVAL=5m
UP_SESSION_COOKIE_SECURE=true
UP_SESSION_COOKIE_SAME_SITE=lax
UP_SESSION_ENCRYPTION_KEY=""
UP_SESSION_ENCRYPTION_KEY_ID=""

# MFA and authentication rate limiting
UP_MFA_CHALLENGE_TTL=5m
UP_MFA_MAX_ATTEMPTS=5
UP_LOGIN_RATE_LIMIT=10
UP_LOGIN_RATE_WINDOW=15m
UP_MFA_RATE_LIMIT=10
UP_MFA_RATE_WINDOW=15m

# Objective risk defense and CAPTCHA providers
UP_RISK_DEFENSE_ENABLED=false
UP_RISK_OBSERVATION_WINDOW=15m
UP_RISK_LOGIN_MEDIUM_AFTER=3
UP_RISK_LOGIN_HIGH_AFTER=7
UP_RISK_REGISTRATION_MEDIUM_AFTER=2
UP_RISK_REGISTRATION_HIGH_AFTER=3
UP_RISK_CHALLENGE_TTL=5m
UP_RISK_DEVICE_ID_TTL=720h
UP_RISK_TRUST_TTL=15m
UP_RISK_AUTOMATION_COST_DIFFICULTY=18
UP_RISK_COMPLETION_LIMIT=8
UP_RISK_COMPLETION_WINDOW=15m
UP_RISK_ALLOWLIST_SHA256=""
UP_RISK_CAPTCHA_REGION=mainland_china
UP_RISK_TURNSTILE_SITE_KEY=""
UP_RISK_TURNSTILE_SECRET_KEY=""
UP_RISK_TURNSTILE_HOSTNAME=""
UP_RISK_RECAPTCHA_SITE_KEY=""
UP_RISK_RECAPTCHA_SECRET_KEY=""
UP_RISK_RECAPTCHA_HOSTNAME=""
UP_RISK_RECAPTCHA_MIN_SCORE=0.7

# Authentication provider (fake is development-only; empty disables it)
UP_AUTH_PROVIDER=""
UP_AUTH_PROVIDER_BASE_URL=""
UP_AUTH_PROVIDER_PROJECT_ID=""
UP_AUTH_PROVIDER_ORGANIZATION_ID=""
UP_AUTH_PROVIDER_CLIENT_ID=""
UP_AUTH_PROVIDER_CLIENT_SECRET=""
UP_AUTH_PROVIDER_SERVICE_ACCOUNT_KEY_FILE=""
UP_AUTH_PROVIDER_DOMAIN=""

# Trusted reverse-proxy boundary
UP_TRUSTED_PROXY_CIDRS="127.0.0.1/32,::1/128"

# Public email registration (default off)
UP_PUBLIC_REGISTRATION_ENABLED=false
UP_REGISTRATION_CREATE_IP_LIMIT=3
UP_REGISTRATION_CREATE_IP_WINDOW=1h
UP_REGISTRATION_CREATE_NET_LIMIT=10
UP_REGISTRATION_CREATE_NET_WINDOW=1h
UP_REGISTRATION_CREATE_EMAIL_LIMIT=3
UP_REGISTRATION_CREATE_EMAIL_WINDOW=24h
UP_REGISTRATION_CREATE_PAIR_LIMIT=2
UP_REGISTRATION_CREATE_PAIR_WINDOW=1h
UP_REGISTRATION_VERIFY_LIMIT=8
UP_REGISTRATION_VERIFY_WINDOW=15m
UP_REGISTRATION_RESEND_LIMIT=3
UP_REGISTRATION_RESEND_WINDOW=30m
UP_REGISTRATION_IPV4_NET_BITS=24
UP_REGISTRATION_IPV6_NET_BITS=56

# WeChat Mini Program login, registration, and onboarding (default off)
UP_WECHAT_MINIPROGRAM_ENABLED=false
UP_WECHAT_MINIPROGRAM_REGISTRATION_ENABLED=false
UP_WECHAT_MINIPROGRAM_ONBOARDING_ENABLED=false
UP_WECHAT_MINIPROGRAM_ONBOARDING_ENCRYPTION_KEY=""
UP_WECHAT_MINIPROGRAM_ONBOARDING_ENCRYPTION_KEY_ID=""
UP_WECHAT_MINIPROGRAM_ONBOARDING_RETAINED_DECRYPTION_KEYS=""
UP_WECHAT_MINIPROGRAM_APP_ID=""
UP_WECHAT_MINIPROGRAM_APP_SECRET=""
UP_WECHAT_MINIPROGRAM_API_BASE_URL="https://api.weixin.qq.com"
UP_WECHAT_MINIPROGRAM_REQUEST_TIMEOUT=8s

# QR authentication (default off)
UP_QR_AUTH_ENABLED=false
UP_QR_AUTH_CHALLENGE_TTL=2m
UP_QR_AUTH_RATE_LIMIT=12
UP_QR_AUTH_RATE_WINDOW=2m

# DreamUP native mobile bridge (default off)
UP_DREAMUP_MOBILE_ENABLED=false
UP_DREAMUP_MOBILE_DELEGATION_KEYRING_PATH=""
UP_DREAMUP_MOBILE_DELEGATION_CURRENT_KEY_ID=""
UP_DREAMUP_MOBILE_DELEGATION_ISSUER=""
UP_DREAMUP_MOBILE_DELEGATION_AUDIENCE=dreamup-mobile-api
UP_DREAMUP_MOBILE_ASSERTION_TTL=15s
UP_DREAMUP_MOBILE_SCOPED_RATE_LIMIT=60
UP_DREAMUP_MOBILE_GLOBAL_RATE_LIMIT=2000
UP_DREAMUP_MOBILE_RATE_WINDOW=1m

# Aliyun SMS phone verification (default off)
# Runtime delivery is pinned to this official HTTPS origin and rejects redirects.
UP_ALIYUN_SMS_ENABLED=false
UP_ALIYUN_SMS_ACCESS_KEY_ID=""
UP_ALIYUN_SMS_ACCESS_KEY_SECRET=""
UP_ALIYUN_SMS_SIGN_NAME=""
UP_ALIYUN_SMS_TEMPLATE_CODE=""
UP_ALIYUN_SMS_ENDPOINT="https://dysmsapi.aliyuncs.com/"
UP_INTERNAL_SMS_ENABLED=false
UP_INTERNAL_SMS_ENDPOINT=""
UP_INTERNAL_SMS_API_KEY=""
UP_INTERNAL_SMS_FROM=""
UP_INTERNAL_SMS_TIMEOUT=10s
UP_PHONE_VERIFY_TTL=5m

# Development permission override (default off; rejected in production)
UP_PERMISSION_DEV_OVERRIDE=false
UP_PERMISSION_DEV_OVERRIDE_USER_ID=""

# Reauthentication and OAuth client-secret rotation
UP_REAUTH_CHALLENGE_TTL=5m
UP_REAUTH_GRANT_TTL=5m
UP_REAUTH_MAX_ATTEMPTS=5
UP_REAUTH_RATE_LIMIT=10
UP_REAUTH_RATE_WINDOW=15m
UP_REAUTH_CLEANUP_INTERVAL=60s
UP_SECRET_ROTATION_GRACE_PERIOD=0s
UP_SECRET_ROTATION_RATE_LIMIT=3
UP_SECRET_ROTATION_RATE_WINDOW=15m

# Security-state mutation fencing
UP_SECURITY_PROVIDER_DEADLINE=10s
UP_SECURITY_LEASE_TTL=60s
UP_SECURITY_SETTLEMENT_TIMEOUT=15s
UP_SECURITY_RECOVERY_TIMEOUT=15s
UP_SECURITY_MAX_SETTLEMENT_ATTEMPTS=3

# Public OAuth topology and legacy DreamUP owner mapping
UP_OAUTH_PUBLIC_ORIGIN=""
UP_DREAMUP_OWNER_USER_ID=""

# Feishu provider (credentials form an atomic set)
UP_FEISHU_BASE_URL="https://open.feishu.cn"
UP_FEISHU_AUTHORIZE_URL="https://accounts.feishu.cn/open-apis/authen/v1/authorize"
UP_FEISHU_APP_ID=""
UP_FEISHU_APP_SECRET=""
UP_FEISHU_TENANT_ID=""
UP_FEISHU_REDIRECT_URL=""
UP_FEISHU_CONTACT_SCOPE="应用通讯录授权范围"
UP_FEISHU_OAUTH_STATE_TTL=5m
UP_FEISHU_REQUEST_TIMEOUT=15s
UP_FEISHU_RECONCILE_INTERVAL=15s
UP_FEISHU_SYNC_TIMEOUT=2m

# Cerbos PDP and mutable Admin API
UP_CERBOS_PDP_URL=""
UP_CERBOS_ADMIN_URL=""
UP_CERBOS_ADMIN_USERNAME=""
UP_CERBOS_ADMIN_PASSWORD=""
UP_CERBOS_REQUEST_TIMEOUT=3s
UP_CERBOS_RECONCILE_INTERVAL=30s

# DreamUP administration BFF (default off)
UP_DREAMUP_ADMIN_ENABLED=false
UP_DREAMUP_ADMIN_MINIPROGRAM_ENABLED=false
UP_ADMIN_CHALLENGE_ENCRYPTION_KEYRING_PATH=""
UP_ADMIN_CHALLENGE_ENCRYPTION_CURRENT_KEY_ID=""
UP_ADMIN_CHALLENGE_PEPPER_KEYRING_PATH=""
UP_ADMIN_CHALLENGE_PEPPER_CURRENT_KEY_ID=""
UP_PROTECTED_REASON_KEYRING_PATH=""
UP_PROTECTED_REASON_CURRENT_KEY_ID=""
UP_ADMIN_CHALLENGE_RATE_LIMIT_KEYRING_PATH=""
UP_ADMIN_CHALLENGE_RATE_LIMIT_CURRENT_KEY_ID=""
UP_ADMIN_OPERATION_FINGERPRINT_KEYRING_PATH=""
UP_ADMIN_OPERATION_FINGERPRINT_CURRENT_KEY_ID=""
UP_DREAMUP_DELEGATION_KEYRING_PATH=""
UP_DREAMUP_DELEGATION_CURRENT_KEY_ID=""
UP_DREAMUP_ADMIN_BASE_URL="http://127.0.0.1:18084"
UP_DREAMUP_DELEGATION_ISSUER=""
UP_DREAMUP_DELEGATION_AUDIENCE=dreamup-admin-api
UP_DREAMUP_ADMIN_ORIGIN=""
UP_DREAMUP_ADMIN_RESPONSE_LIMIT_BYTES=8388608
UP_DREAMUP_RECONCILE_INTERVAL=15s
UP_DREAMUP_RECONCILE_BATCH_SIZE=50
UP_DREAMUP_RECONCILE_LEASE=30s
UP_DREAMUP_DELEGATION_SERVICE_SUBJECT=united-pass:dreamup-reconciler
UP_DREAMUP_DELEGATION_SERVICE_VERSION=1
UP_ADMIN_CHALLENGE_FRESH_LOGIN_MAX_AGE=5m
UP_ADMIN_CHALLENGE_GENERAL_FRESHNESS=30m
UP_ADMIN_CHALLENGE_HIGH_RISK_FRESHNESS=5m
UP_ADMIN_CHALLENGE_RATE_LIMIT=5
UP_ADMIN_CHALLENGE_RATE_WINDOW=15m
UP_ADMIN_CHALLENGE_LOCK_DURATION=30m
UP_ADMIN_CHALLENGE_ARGON2_MAX_CONCURRENT=2

# Email delivery and internal notification relay
UP_SMTP_HOST=""
UP_SMTP_PORT=465
UP_SMTP_USER=""
UP_SMTP_PASS=""
UP_SMTP_FROM=""
UP_SMTP_FROM_NAME=""
UP_INTERNAL_EMAIL_TOKEN=""

# Integration-test ownership inputs (set only by the local test matrix)
UP_TEST_DATABASE_URL=""
UP_TEST_DATABASE_SCHEMA=united_pass_test
UP_TEST_REDIS_URL=""
UP_TEST_REDIS_KEY_PREFIX=up:test:
